# Supabase — Settings → API Keys
# La key pública: en proyectos nuevos es una publishable key (sb_publishable_...),
# en proyectos viejos es el JWT anon (eyJhbGc...). Las dos van en la misma variable.
# NUNCA poner acá la secret key / service_role — bypassea RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key

# Resend (Edge Function secrets, NO se usan en el frontend — se cargan
# en Supabase dashboard → Edge Functions → Secrets)
# RESEND_API_KEY=re_xxx
# LEAD_NOTIFICATION_EMAIL=info@neos.ar
# FROM_EMAIL=Neo <neo@neos.ar>
